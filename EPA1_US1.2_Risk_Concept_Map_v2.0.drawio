<mxfile host="app.diagrams.net"><diagram id="us12p1" name="1 Attack paths"><mxGraphModel dx="1350" dy="1466" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1466" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Basic Risk concept map – MUDT AI Learning Assistant Platform (US-1.2 / EPA-IS-1) – v2.0 team draft · page 1: attack paths" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1310" height="22" as="geometry"/></mxCell><mxCell id="c4" value="Chain: a threat uses an entry point, crosses a trust boundary along a data flow, exploits a vulnerability, which puts an asset at risk; the risk causes impact on a business outcome; a control reduces the risk (S1 slide 32). Paths are hypotheses and do not claim that a vulnerability exists (S2 slide 16). Asset IDs follow the team asset register; TB IDs the Platform Map; DF IDs the data-flow register in system-definition.md; AP IDs are used in the risk register (column &quot;Attack path&quot;)." style="text;html=1;whiteSpace=wrap;fontSize=9;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="1310" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Trust boundaries (team Platform Map):  TB1 Internet → DMZ   ·   TB2 DMZ → internal zone   ·   TB3 Cloud → gateway → on-prem   ·   TB4 Users → cloud   ·   TB5 Our tenant → LLM provider   ·   TB6 Admin path.   Asset IDs: team asset register (E/S); BO = business outcome." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#d9f0ee;strokeColor=#2a8a7f;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="1310" height="30" as="geometry"/></mxCell><mxCell id="c6" value="Path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="78" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Threat" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#b85450;strokeColor=#b85450;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="124" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Entry point" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#666666;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Trust boundary · data flows" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#2a8a7f;strokeColor=#2a8a7f;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="476" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Vulnerability (assumed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#d79b00;strokeColor=#d79b00;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="652" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c11" value="Asset affected" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="828" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c12" value="Risk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1004" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c13" value="Impact → business outcome" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#ae4132;strokeColor=#ae4132;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1180" y="132" width="150" height="24" as="geometry"/></mxCell><mxCell id="c14" value="AP1&lt;br&gt;Ransomware&lt;br&gt;(R01)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="78" height="70" as="geometry"/></mxCell><mxCell id="c15" value="T2 Cybercriminal group&lt;br&gt;(goal: ransom)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="124" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Portal S11 or phishing of staff (EP8 / EP5), admin path EP7" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c17" value="TB1 or TB6&lt;br&gt;DF01 / DF17 → DF18 (backups reachable)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#d9f0ee;strokeColor=#2a8a7f;" vertex="1" parent="1"><mxGeometry x="476" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c18" value="Unpatched server; backups online on the same network" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="652" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Servers S24, Database S18, Storage S23 → Grades E15 – Availability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="828" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c20" value="On-premises systems encrypted, service stops" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1004" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c21" value="Teaching and administration stop → BO2 → BO1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;arcSi