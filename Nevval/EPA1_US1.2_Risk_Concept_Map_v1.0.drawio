<diagram id="page1" name="1 Concept map"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0_t0" value="&lt;b&gt;Basic Risk Concept Map - Asset → Threat → Vulnerability → Risk scenario → Impact → Control&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontFamily=Arial;fontColor=#1F3864;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1590" height="30" as="geometry"/></mxCell><mxCell id="p0_t1" value="MUDT AI Learning Assistant Platform · EPA-IS-1 (PCU-IS-1) Assess security risks and threats · v1.0 · 2026-10-30 · Hafsa Nevval Yaman (nevval2206) · Read each row: the asset is targeted by a threat, which exploits a vulnerability, which enables the risk scenario, which causes the impact; the control reduces the risk (dashed)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=Arial;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1590" height="22" as="geometry"/></mxCell><mxCell id="p0_h_ASSET" value="&lt;b&gt;ASSET&lt;/b&gt;&lt;br&gt;Something valuable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#1F3864;strokeWidth=2;fontSize=11;fontFamily=Arial;align=center;spacingLeft=6;spacingRight=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="230" height="42" as="geometry"/></mxCell><mxCell id="p0_h_THREAT" value="&lt;b&gt;THREAT&lt;/b&gt;&lt;br&gt;Potential cause of harm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE8E8;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontFamily=Arial;align=center;spacingLeft=6;spacingRight=6;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="310" y="88" width="230" height="42" as="geometry"/></mxCell><mxCell id="p0_h_VULNERABILITY" value="&lt;b&gt;VULNERABILITY&lt;/b&gt;&